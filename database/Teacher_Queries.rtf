\f0\b \cf0 Reports\

\f1\b0 \
        SELECT \
        s.first_name, \
        s.surname, \
        c.course_name, \
        m.module_name, \
        a.assignment_1, \
        a.assignment_2, \
        a.exam, \
        a.result\
        FROM student s\
        LEFT JOIN class_group cg        ON s.class_group_code = cg.class_group_code\
        LEFT JOIN course c             ON cg.course_id = c.course_id\
        LEFT JOIN course_has_module chm ON c.course_id = chm.course_id \
        LEFT JOIN module m             ON chm.qqi_module_code = m.qqi_module_code\
        LEFT JOIN assessment a    ON (\
        a.student_id = s.student_id AND \
        a.qqi_module_code = m.qqi_module_code\
        )\
        WHERE s.student_id = ?\
        ORDER BY m.module_name ASC;\
  - Bring a specific student report with all modules and grades.\
\
SELECT qqi_module_code,\
                 module_name\
                 FROM module\
                 ORDER BY module_name ASC;\
 - Modules list\
\
SELECT \\n"\
                + "    s.first_name, \\n"\
                + "    s.surname, \\n"\
                + "    m.module_name, \\n"\
                + "    a.result\\n"\
                + "FROM student s\\n"\
                + "JOIN assessment a ON s.student_id = a.student_id\\n"\
                + "JOIN module m ON a.qqi_module_code = m.qqi_module_code\\n"\
                + "WHERE a.result > 9 \\n"\
                + "  AND TRIM(a.qqi_module_code) = ?;\
 - A List of distinction  (>9) students by Module\
\
SELECT \
            m.module_name, \
            CONCAT(s.first_name, ' ', s.surname) AS student_name, \
            a.result\
        FROM student s\
        JOIN class_group cg ON s.class_group_code = cg.class_group_code\
        JOIN course_has_module chm ON cg.course_id = chm.course_id\
        JOIN module m ON chm.qqi_module_code = m.qqi_module_code\
        LEFT JOIN assessment a ON (s.student_id = a.student_id AND m.qqi_module_code = a.qqi_module_code)\
        WHERE s.class_group_code = ?\
        ORDER BY m.module_name ASC, s.first_name ASC;\
 - Full Class group Report (With All Modules, Students and Results)\
\
SELECT * FROM final_project.course\
 - All courses\
\
"SELECT class_group_code FROM class_group WHERE course_id = ?";\
 - Select a specific class group\
\
SELECT DISTINCT m.module_name\
        FROM class_group cg\
        JOIN course_has_module chm ON cg.course_id = chm.course_id\
        JOIN module m ON chm.qqi_module_code = m.qqi_module_code\
        WHERE cg.class_group_code = ?\
 - Select the modules of a class group\
\
SELECT \
            s.first_name, \
            s.surname, \
            a.assignment_1, \
            a.assignment_2, \
            a.exam, \
            a.result\
        FROM student s\
        JOIN assessment a ON s.student_id = a.student_id\
        JOIN module m ON a.qqi_module_code = m.qqi_module_code\
        WHERE s.class_group_code = ?\
          AND m.module_name = ?;\
 - Select the students, and the grades for a specific module, for a specific class.\
\
SELECT qqi_module_code,\
                     module_name\
                     FROM module\
                     ORDER BY module_name ASC;\
 - List with all Modules\
\
SELECT \
                     s.first_name, \
                     s.surname, \
                     a.assignment_1, \
                     a.assignment_2, \
                     a.exam, \
                     a.result\
                 FROM student s\
                 JOIN assessment a ON s.student_id = a.student_id\
                 JOIN module m ON a.qqi_module_code = m.qqi_module_code\
                 WHERE m.module_name = ?\
                 ORDER BY first_name ASC\
 - Select all students, across all courses for a specific module.\
(Some modules repeat in different courses, eg. Work Experience)\
