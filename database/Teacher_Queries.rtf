\f0\b\fs24 \cf0 Enter Results\
\

\f1\b0 "SELECT * FROM final_project.course";\
 - Show all courses\
\
"SELECT class_group_code FROM class_group WHERE course_id = ?";\
 - Show a class group from course ID\
\
SELECT DISTINCT m.module_name\
        FROM class_group cg\
        JOIN course_has_module chm ON cg.course_id = chm.course_id\
        JOIN module m ON chm.qqi_module_code = m.qqi_module_code\
        WHERE cg.class_group_code = ?\
 - Show the modules for a class group\
\
SELECT \
            s.student_id,\
            s.first_name, \
            s.surname, \
            a.assignment_1, \
            a.assignment_2, \
            a.exam, \
            a.result\
        FROM student s\
        JOIN assessment a ON s.student_id = a.student_id\
        JOIN module m ON a.qqi_module_code = m.qqi_module_code\
        WHERE s.class_group_code = ?\
          AND m.module_name = ?;\
 - Show the students, grades and result, for a module of a class group.\
\
UPDATE assessment \
        SET assignment_1 = ?, assignment_2 = ?, exam = ?, result = ?\
        WHERE student_id = ? \
        AND qqi_module_code = (SELECT qqi_module_code FROM module WHERE module_name = ? LIMIT 1)\
 - Update grades and result for a student.\
\
"SELECT student_id, first_name, middle_name, surname FROM student ORDER BY first_name, surname";\
- Show a list with all students\
\
SELECT \
        s.first_name,\
        s.middle_name,\
        s.surname, \
        c.course_name, \
        m.module_name, \
        a.assignment_1, \
        a.assignment_2, \
        a.exam, \
        a.result\
        FROM student s\
        JOIN class_group cg        ON s.class_group_code = cg.class_group_code\
        JOIN course c             ON cg.course_id = c.course_id\
        JOIN course_has_module chm ON c.course_id = chm.course_id \
        JOIN module m             ON chm.qqi_module_code = m.qqi_module_code\
        LEFT JOIN assessment a    ON (\
        a.student_id = s.student_id AND \
        a.qqi_module_code = m.qqi_module_code\
        )\
        WHERE s.student_id = ?\
        ORDER BY m.module_name ASC;\
 - Show all modules and grades for a student.\
\
UPDATE assessment a \
        JOIN module m ON a.qqi_module_code = m.qqi_module_code\
        SET a.assignment_1 = ?, a.assignment_2 = ?, a.exam = ?, a.result = ?\
        WHERE a.student_id = ? AND m.module_name = ?\
 - Update the grades and result for a student, for a module.\
\
